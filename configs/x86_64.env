# Official OpenWrt 25.12 (x86/64) ImageBuilder — PVE LXC sidecar rootfs
OPENWRT_VERSION=25.12.5
TARGET=x86
SUBTARGET=64
PROFILE=generic

DOWNLOAD_BASE=https://downloads.openwrt.org/releases/${OPENWRT_VERSION}/targets/${TARGET}/${SUBTARGET}
IMAGEBUILDER_ARCHIVE=openwrt-imagebuilder-${OPENWRT_VERSION}-${TARGET}-${SUBTARGET}.Linux-x86_64.tar.zst
IMAGEBUILDER_SHA256=313221253d9bac534e4a4ee6492a4941b4ba0f43200eceb8d16a4785470ae9df

# Sidecar (旁路由): LuCI + HTTPS. No PPP. 25.12 uses apk (not opkg).
# LXC uses the PVE host kernel; OpenWrt kmods in the profile are unused.
PACKAGES="luci luci-ssl luci-app-package-manager -ppp -ppp-mod-pppoe -luci-proto-ppp -kmod-ppp -kmod-pppoe -kmod-pppox"

EXTRA_IMAGE_NAME=pve-lxc
OUTPUT_NAME=openwrt-${OPENWRT_VERSION}-x86-64-pve-lxc.tar.gz
